{
  "manifest_version": 3,
  "name": "DSH 对话迁移（DeepSeek → DeepSeek Harness）",
  "version": "0.3.1",
  "description": "从 chat.deepseek.com 抓取单个或多个对话，导出成 JSON，再由本地脚本重建为 DSH 会话。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage", "downloads", "activeTab", "scripting"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://files.deepseeksvc.com/*",
    "https://cdn.deepseek.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["stream-parser.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH 对话迁移"
  }
}
