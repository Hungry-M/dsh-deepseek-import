{
  "name": "dsh-deepseek-import",
  "version": "0.3.1",
  "description": "DeepSeek web chat → DeepSeek Harness sessions (Edge extension + importer CLI + DSH plugin)",
  "type": "module",
  "license": "MIT",
  "author": "Hungry-M",
  "bin": {
    "dsh-import": "./dsh-import.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "dsh-import.mjs",
    "dsh-import-tui.mjs",
    "dsh-import.cmd",
    "move-session.mjs",
    "remove-session.mjs",
    "repair-session.mjs",
    "doctor.mjs",
    "audit-imports.mjs",
    "edge-extension/",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chat",
    "import",
    "migration",
    "edge-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hungry-M/dsh-deepseek-import.git"
  },
  "scripts": {
    "list": "node dsh-import.mjs --list",
    "tui": "node dsh-import-tui.mjs",
    "audit": "node repair-session.mjs --audit"
  }
}
